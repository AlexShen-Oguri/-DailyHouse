{
  "manifest_version": 3,
  "name": "DailyHouse · B站一键读取",
  "version": "1.0.1",
  "description": "仅在小院发起读取后，读取B站历史页上的最近7天记录并导入本机书架。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/history*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开日常小院书架"
  }
}
