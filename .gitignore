# Credentials and secrets: never commit.
.env
.env.*
!.env.example
!**/.env.example

# Local profiles and runtime state.
work-profile.local.json
.runtime/

# Personal data, managed attachments and legacy databases.
backend/data/*
!backend/data/.gitkeep

# Preserved local output from the retired EventKit helper.
backend/native/bin/

# Logs.
logs/
*.log

# Generated build output.
backend/dist/
frontend/dist/
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo
frontend/*.js.timestamp-*.mjs

# Dependencies.
node_modules/

# System files.
.DS_Store

# Local browser sessions, screenshots, and personal research are not source code.
.playwright-cli/
.impeccable/review/
output/
docs/个人需求侧写与候选功能.md
*.local.json
*.local.md

# Supabase CLI links, cache and private runtime state are device-local.
supabase/.temp/
supabase/.branches/
supabase/.env
